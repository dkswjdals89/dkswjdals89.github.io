{
  "name": "lukeahn89-resume",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-pdfs.mjs",
    "build:pdf": "node scripts/generate-pdfs.mjs",
    "build:all": "astro build && node scripts/generate-pdfs.mjs",
    "preview": "astro preview",
    "test:resume": "node --test tests/multilingual-resume.test.mjs",
    "test:pdf": "node --test tests/pdf-targets.test.mjs",
    "test": "astro build && node --test tests/career-years.test.mjs tests/multilingual-resume.test.mjs tests/pdf-targets.test.mjs tests/dependency-security.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.2.8",
    "simple-icons": "^16.25.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
